layout {

    focus-ring {
        active-color   "#56dbc5"
        inactive-color "#0b151a"
        urgent-color   "#ffb4ab"
    }

    border {
        active-color   "#56dbc5"
        inactive-color "#0b151a"
        urgent-color   "#ffb4ab"
    }


    tab-indicator {
        active-color   "#56dbc5"
        inactive-color "#005046"
        urgent-color   "#ffb4ab"
    }

    insert-hint {
        color "#56dbc580"
    }
}

recent-windows {
    highlight {
        active-color "#56dbc5"
        urgent-color "#ffb4ab"
    }
}
