layout {

    focus-ring {
        active-color   "#4cdada"
        inactive-color "#0c141b"
        urgent-color   "#ffb4ab"
    }

    border {
        active-color   "#4cdada"
        inactive-color "#0c141b"
        urgent-color   "#ffb4ab"
    }


    tab-indicator {
        active-color   "#4cdada"
        inactive-color "#00504f"
        urgent-color   "#ffb4ab"
    }

    insert-hint {
        color "#4cdada80"
    }
}

recent-windows {
    highlight {
        active-color "#4cdada"
        urgent-color "#ffb4ab"
    }
}
