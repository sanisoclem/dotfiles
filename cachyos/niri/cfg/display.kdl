// ────────────── Outputs ──────────────
// Run `niri msg outputs` to get the name and modes of the displays attached to
// this machine, then edit the block below. An unknown name is simply ignored,
// so a config that names a monitor you don't have is harmless.
// https://yalter.github.io/niri/Configuration:-Outputs

output "HDMI-A-2" {
    mode "5120x2160@60.000"
    scale 1.67
    transform "normal"
    position x=0 y=0
}
