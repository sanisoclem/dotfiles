// ────────────── Input ──────────────
// https://yalter.github.io/niri/Configuration:-Input

input {
    keyboard {
        xkb {
            // Nothing set: Mod is Super, Alt is Alt.
            // layout "us"
        }

        numlock
    }

    touchpad {
        tap
        natural-scroll
    }

    // Warp the pointer to the middle of whatever window takes focus.
    warp-mouse-to-focus

    // Focus follows the mouse, but only across windows already fully on screen —
    // max-scroll-amount="0%" stops a stray pointer from scrolling the view.
    focus-follows-mouse max-scroll-amount="0%"

    // this option sucks
    // workspace-auto-back-and-forth
}
