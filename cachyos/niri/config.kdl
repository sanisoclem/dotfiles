// niri config, in KDL: https://kdl.dev
// Full reference: https://yalter.github.io/niri/Configuration:-Introduction
//
// The cfg/ split and this include order are CachyOS's, kept as-is so this stays
// easy to diff against a stock install. The contents are ours.
//
// noctalia.kdl is generated by noctalia's `niri` colour template on every theme
// change, and is included last so its colours win over the ones in layout.kdl.
// Do not remove the include line: noctalia appends its own copy if it's missing,
// which would leave this tracked file dirty.

include "./cfg/animation.kdl"
include "./cfg/autostart.kdl"
include "./cfg/keybinds.kdl"
include "./cfg/input.kdl"
include "./cfg/display.kdl"
include "./cfg/layout.kdl"
include "./cfg/rules.kdl"
include "./cfg/misc.kdl"


include "noctalia.kdl"
