#!/usr/bin/env bash

set -euo pipefail

REPO_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)"
CACHY="$REPO_ROOT/cachyos"
CONFIG="$HOME/.config"
BACKUP="$HOME/.config-backup"

step() { printf '\n\033[1;34m==>\033[0m %s\n' "$*"; }
info() { printf '  %s\n' "$*"; }
warn() { printf '\033[1;33m  ! \033[0m%s\n' "$*"; }
die() {
  printf '\033[1;31mfatal:\033[0m %s\n' "$*" >&2
  exit 1
}
have() { command -v "$1" >/dev/null 2>&1; }

link() {
  local src="$1" dst="$2"
  if [[ -L "$dst" ]]; then
    info "$dst already a symlink -> $(readlink "$dst")"
  elif [[ -e "$dst" ]]; then
    warn "$dst already exists — not touching it"
  else
    ln -s "$src" "$dst"
    info "$dst -> $src"
  fi
}

have pacman || die "no pacman — this script is for arch"

# packages

PACKAGES=(
  fish starship zoxide fzf
  bat
  eza
  fd
  ripgrep
  dust
  btop procs duf ncdu tree
  rocm-smi-lib # btop needs this for amd gpu
  jq yq
  tealdeer
  fastfetch atuin direnv just entr hyperfine glow
  wl-clipboard xclip
  7zip
  unzip unarchiver unrar
  fortune-mod # fish_greeting

  # dev
  neovim git github-cli
  git-delta
  difftastic
  gnupg pinentry
  lazygit lazydocker zellij yazi superfile
  docker docker-compose tokei
  uv python-pip nodejs npm
  base-devel
  cmake
  openssl
  sd
  fnm rustup go
  gdu figlet

  # yazi's preview backends
  ffmpeg
  ffmpegthumbnailer
  imagemagick
  poppler chafa

  niri noctalia-shell ghostty
  fuzzel swaylock playerctl pamixer brightnessctl xwayland-satellite
  capitaine-cursors qt6ct

  ttf-firacode-nerd ttf-nerd-fonts-symbols ttf-nerd-fonts-symbols-mono
)

step "installing packages"
sudo pacman -Syu --needed --noconfirm "${PACKAGES[@]}"

# carapace
CARAPACE_VERSION=1.7.3

if have carapace; then
  info "carapace already installed ($(carapace --version 2>/dev/null || echo unknown))"
else
  step "carapace $CARAPACE_VERSION"
  carapace_tmp="$(mktemp -d)"
  trap 'rm -rf "$carapace_tmp"' EXIT

  carapace_base="https://github.com/carapace-sh/carapace-bin/releases/download/v$CARAPACE_VERSION"
  carapace_tar="carapace-bin_${CARAPACE_VERSION}_linux_amd64.tar.gz"

  if curl -fsSL -o "$carapace_tmp/$carapace_tar" "$carapace_base/$carapace_tar" &&
    curl -fsSL -o "$carapace_tmp/checksums.txt" \
      "$carapace_base/carapace-bin_${CARAPACE_VERSION}_checksums.txt" &&
    (cd "$carapace_tmp" && sha256sum --check --ignore-missing --status checksums.txt); then
    mkdir -p "$HOME/.local/bin"
    tar -xzf "$carapace_tmp/$carapace_tar" -C "$carapace_tmp" carapace
    install -m 0755 "$carapace_tmp/carapace" "$HOME/.local/bin/carapace"
    info "installed $HOME/.local/bin/carapace"
  else
    warn "carapace download or checksum failed — config.fish skips it if absent"
  fi

  rm -rf "$carapace_tmp"
  trap - EXIT
fi

if have tte; then
  info "tte already installed"
else
  step "terminaltexteffects (tte)"
  uv tool install terminaltexteffects
fi

# install stable toolchain because it isn't installed by default when using packaed rustup
if rustup toolchain list 2>/dev/null | grep -q 'no installed toolchains'; then
  step "rust toolchain"
  rustup default stable
else
  info "rust toolchain already installed"
fi

if [[ -f "$HOME/.cargo/env" ]]; then
  source "$HOME/.cargo/env"
fi

# config symlink
step "adopting $CONFIG"
[[ -d "$CACHY" ]] || die "no cachyos/ directory at $CACHY"

if [[ -L "$CONFIG" ]]; then
  info "already a symlink -> $(readlink "$CONFIG")"
elif [[ -e "$BACKUP" ]]; then
  warn "$BACKUP already exists — leaving $CONFIG alone"
else
  [[ -d "$CONFIG" ]] || die "$CONFIG is missing or not a directory"

  skipped=()
  while IFS= read -r -d '' src; do
    name="$(basename "$src")"
    if [[ -e "$CACHY/$name" || -L "$CACHY/$name" ]]; then
      skipped+=("$name")
    else
      cp -a "$src" "$CACHY/$name"
    fi
  done < <(find "$CONFIG" -mindepth 1 -maxdepth 1 -print0 | sort -z)

  if ((${#skipped[@]})); then
    info "already in cachyos/, skipped:"
    printf '    %s\n' "${skipped[@]}"
  fi

  mv "$CONFIG" "$BACKUP"
  ln -s "$CACHY" "$CONFIG"
  info "$CONFIG -> $CACHY, old contents at $BACKUP"
fi

# github ssh workaround
step "ssh config"
mkdir -p "$HOME/.ssh"
chmod 700 "$HOME/.ssh" # ssh ignores the directory outright if it's too open
link "$REPO_ROOT/ssh_config" "$HOME/.ssh/config"

step "gitconfig"
link "$REPO_ROOT/.gitconfig" "$HOME/.gitconfig"

# gpg pinentry
step "gpg pinentry"
GNUPGHOME="${GNUPGHOME:-$HOME/.gnupg}"
AGENT_CONF="$GNUPGHOME/gpg-agent.conf"
PINENTRY="/usr/bin/pinentry-gnome3"

mkdir -p "$GNUPGHOME"
chmod 700 "$GNUPGHOME"

if [[ ! -x "$PINENTRY" ]]; then
  warn "$PINENTRY missing — leaving gpg-agent on its default"
elif grep -qs '^pinentry-program' "$AGENT_CONF"; then
  info "already set: $(grep '^pinentry-program' "$AGENT_CONF")"
else
  printf 'pinentry-program %s\n' "$PINENTRY" >>"$AGENT_CONF"
  chmod 600 "$AGENT_CONF"
  info "wrote $AGENT_CONF"
  gpgconf --kill gpg-agent >/dev/null 2>&1 || true
fi

# immich api key
step "immich api key"
IMMICH_STATE="$HOME/.local/state/immich-wallpaper"

if [[ -f "$IMMICH_STATE/api-key" ]]; then
  info "already set at $IMMICH_STATE/api-key"
else
  read -rsp "  immich api key (Account Settings -> API Keys, blank to skip): " key
  echo
  if [[ -n "$key" ]]; then
    mkdir -p "$IMMICH_STATE"
    printf '%s' "$key" >"$IMMICH_STATE/api-key"
    chmod 600 "$IMMICH_STATE/api-key"
    info "wrote $IMMICH_STATE/api-key (${#key} chars)"
  else
    warn "skipped — immich-wallpaper will not run until this exists"
  fi
  unset key
fi

# systemd
step "systemd timers"
systemctl --user daemon-reload
systemctl --user enable --now immich-wallpaper.timer
info "next run: $(systemctl --user list-timers immich-wallpaper.timer --no-pager | awk 'NR==2 {print $1, $2, $3}')"

step "status"
for t in fish starship zoxide fzf carapace eza bat fd rg fastfetch \
  lazygit lazydocker zellij yazi spf nvim gh niri noctalia ghostty; do
  if have "$t"; then
    printf '  \033[32m✓\033[0m %s\n' "$t"
  else printf '  \033[31m✗\033[0m %s\n' "$t"; fi
done

cat <<NOTE

  - relog
  - import GPG keys
  - sudo systemctl enable --now docker && sudo usermod -aG docker "$USER"

To undo the config swap:
  rm "$CONFIG" && mv "$BACKUP" "$CONFIG"
NOTE
