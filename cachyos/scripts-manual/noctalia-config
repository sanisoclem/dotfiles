#!/usr/bin/env bash
#
# noctalia-config — fold what the noctalia UI saved back into this repo.
#
#   ./noctalia-config          rewrite cachyos/noctalia/settings.toml
#   ./noctalia-config --diff   show what it would change, write nothing
#
# noctalia layers ~/.local/state/noctalia/settings.toml over ~/.config/noctalia,
# and the UI only ever writes that state file — so settings changed by hand in
# the shell are live but absent from here until this runs.

set -euo pipefail

HERE="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
SETTINGS="$HERE/../noctalia/settings.toml"
STATE="${XDG_STATE_HOME:-$HOME/.local/state}/noctalia/settings.toml"

TMP="$(mktemp -d)"
trap 'rm -rf "$TMP"' EXIT

info() { printf '  %s\n' "$*"; }
warn() { printf '\033[1;33m  ! \033[0m%s\n' "$*"; }
die() {
  printf '\033[1;31mfatal:\033[0m %s\n' "$*" >&2
  exit 1
}

staged_config_home() {
  install -d "$TMP/config/noctalia"
  install -m 0644 "$SETTINGS" "$TMP/config/noctalia/settings.toml"
  printf '%s\n' "$TMP/config"
}

# config.toml stays out of the staging dir: copying its keys into settings.toml
# would shadow every later edit to config.toml itself.
merged_settings() {
  XDG_CONFIG_HOME="$(staged_config_home)" noctalia config export merged
}

drop_runtime_wallpaper() {
  python3 -c '
import re, sys

RUNTIME = ("wallpaper.default", "wallpaper.last", "wallpaper.monitors")
header = re.compile(r"^\s*\[+(.+?)\]+\s*$")

keep = True
for line in sys.stdin:
    if match := header.match(line):
        table = match.group(1)
        keep = not any(table == r or table.startswith(f"{r}.") for r in RUNTIME)
    if keep:
        sys.stdout.write(line)
'
}

# Dropped by the exporter, but noctalia migrates a config that arrives without it.
config_version() {
  grep -hm1 '^config_version' "$STATE" "$SETTINGS" 2>/dev/null | head -1 || true
}

rebuild() {
  local out="$TMP/settings.toml" version
  version="$(config_version)"
  {
    [[ -z "$version" ]] || printf '%s\n\n' "$version"
    merged_settings | drop_runtime_wallpaper
  } >"$out"

  noctalia config validate "$out" >/dev/null ||
    die "the rebuilt settings do not validate — left $SETTINGS alone"
  printf '%s\n' "$out"
}

do_diff() {
  local rebuilt
  rebuilt="$(rebuild)"

  if cmp -s "$rebuilt" "$SETTINGS"; then
    info "nothing the UI wrote is missing from the repo"
    return 0
  fi
  diff -u --label "$SETTINGS" --label rebuilt "$SETTINGS" "$rebuilt" || true
}

do_sync() {
  local rebuilt
  rebuilt="$(rebuild)"

  if cmp -s "$rebuilt" "$SETTINGS"; then
    info "already in sync"
    return 0
  fi

  install -m 0644 "$rebuilt" "$SETTINGS"
  info "updated $(realpath --relative-to="$HERE/../.." "$SETTINGS")"
  git -C "$HERE" --no-pager diff --stat -- "$SETTINGS" || true
}

command -v noctalia >/dev/null || die "noctalia is not installed"
[[ -f "$SETTINGS" ]] || die "no settings at $SETTINGS"
[[ -f "$STATE" ]] || warn "$STATE absent — the shell has saved nothing to fold in"

case "${1:-}" in
'' | --sync) do_sync ;;
--diff) do_diff ;;
-h | --help) sed -n '2,10p' "$0" | sed 's/^# \{0,1\}//' ;;
*) die "unknown option: $1 (try --help)" ;;
esac
