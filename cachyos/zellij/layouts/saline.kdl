layout {
    cwd "/home/mel/code"

    default_tab_template {
        children
        pane size=1 borderless=true {
            plugin location="zellij:compact-bar"
        }
    }

    tab name="foundry" cwd="foundry" focus=true {
        pane command="fish" {
            args "-C" "nvim"
        }
    }
}
