layout {
    cwd "/home/mel/code"

    default_tab_template {
        children
        pane size=1 borderless=true {
            plugin location="zellij:compact-bar"
        }
    }

    tab name="vibe-ceo" cwd="vibe-ceo" focus=true {
        pane command="fish" {
            args "-C" "nvim"
        }
    }
    tab name="vibe-ceo-next" cwd="vibe-ceo-next" {
        pane command="fish" {
            args "-C" "nvim"
        }
    }
    tab name="vibe-ceo-v2" cwd="vibe-ceo-v2" {
        pane command="fish" {
            args "-C" "nvim"
        }
    }
}
