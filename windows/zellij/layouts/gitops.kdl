layout {
    cwd "/home/mel/codez"
    default_tab_template {
        children
        pane size=1 borderless=true {
            plugin location="compact-bar"
        }
    }
    tab name="gitops" cwd="gitops" focus=true {
        pane command="nvim"
    }
    tab name="clusters" cwd="clusters" {
        pane command="nvim"
    }
}
