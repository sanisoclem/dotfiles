layout {
    cwd "/home/mel/codez"
    default_tab_template {
        children
        pane size=1 borderless=true {
            plugin location="compact-bar"
        }
    }
    tab name="engine" cwd="Engine" focus=true {
        pane command="nvim"
    }
    tab name="nexus" cwd="Nexus" {
        pane command="nvim"
    }
    tab name="campaigns" cwd="CreditClear.Campaigns" {
        pane command="nvim"
    }
    tab name="claim" cwd="Claim" {
        pane command="nvim"
    }
    tab name="data egress" cwd="IntegrationDataEgress" {
        pane command="nvim"
    }
    tab name="integration service" cwd="IntegrationService" {
        pane command="nvim"
    }
    tab name="client portal" cwd="ClientManagementPortal" {
        pane command="nvim"
    }
    tab name="payment api" cwd="PaymentPortalApi" {
        pane command="nvim"
    }
    tab name="creditor api" cwd="CreditorPortalApi" {
        pane command="nvim"
    }
    tab name="experiments" cwd="CreditClear.Experiments" {
        pane command="nvim"
    }
    tab name="iag" cwd="CreditClear.Integration.IAG" {
        pane command="nvim"
    }
}
