#!/usr/bin/env bash
#
# The user half of Arch on WSL, after wsl/provision: a clone of this repo in
# the distro, and the cachyos shell and editor configs linked from it. Safe to
# re-run from either the Windows clone or the WSL one.

set -euo pipefail

SCRIPT_REPO="$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)"
DOTFILES="$HOME/codez/dotfiles"
CONFIG="$HOME/.config"

step() { printf '\n\033[1;34m==>\033[0m %s\n' "$*"; }
info() { printf '  %s\n' "$*"; }
warn() { printf '\033[1;33m  ! \033[0m%s\n' "$*"; }
die() {
  printf '\033[1;31mfatal:\033[0m %s\n' "$*" >&2
  exit 1
}
have() { command -v "$1" >/dev/null 2>&1; }
export PATH="$HOME/.local/bin:$PATH"

# With "replace", a real file or directory at dst is moved aside rather than
# kept: fish writes its own ~/.config/fish the first time it starts, and
# keeping that one leaves the whole repo config unloaded.
link() {
  local src="$1" dst="$2" mode="${3:-}"
  if [[ -L "$dst" ]]; then
    info "$dst already a symlink -> $(readlink "$dst")"
  elif [[ -e "$dst" && "$mode" == replace ]]; then
    local backup
    backup="$dst.bak-$(date +%Y%m%d-%H%M%S)"
    mv "$dst" "$backup"
    ln -s "$src" "$dst"
    warn "$dst -> $src (the old one is at $backup)"
  elif [[ -e "$dst" ]]; then
    warn "$dst already exists — not touching it"
  else
    ln -s "$src" "$dst"
    info "$dst -> $src"
  fi
}

[[ -n "${WSL_DISTRO_NAME:-}" ]] || die "not in WSL — on CachyOS, run cachyos/scripts-manual/setup"
have fish || die "no fish — run wsl/provision as root first"

# Configs link into a clone inside the distro: across /mnt/c, every file read
# goes through 9p, and nvim reads hundreds at startup.
step "dotfiles"
if [[ -d "$DOTFILES/.git" ]]; then
  info "$DOTFILES already cloned"
else
  mkdir -p "$(dirname "$DOTFILES")"
  git clone --quiet "$SCRIPT_REPO" "$DOTFILES"
  git -C "$DOTFILES" remote set-url origin "$(git -C "$SCRIPT_REPO" remote get-url origin)"
  info "cloned to $DOTFILES"
fi

step "config links"
mkdir -p "$CONFIG"
for name in fish nvim lazygit zellij; do
  link "$DOTFILES/cachyos/$name" "$CONFIG/$name" replace
done

# github ssh workaround
step "ssh config"
mkdir -p "$HOME/.ssh"
chmod 700 "$HOME/.ssh" # ssh ignores the directory outright if it's too open
link "$DOTFILES/ssh_config" "$HOME/.ssh/config"

step "gitconfig"
if [[ -e "$HOME/.gitconfig" || -L "$HOME/.gitconfig" ]]; then
  info "$HOME/.gitconfig already exists — not touching it"
else
  read -rp "  git email on this machine (blank for the repo's own): " email
  if [[ -z "$email" ]]; then
    link "$DOTFILES/.gitconfig" "$HOME/.gitconfig"
  else
    # The repo's identity signs with a GPG key this machine doesn't have.
    git config --file "$HOME/.gitconfig" include.path "$DOTFILES/.gitconfig"
    git config --file "$HOME/.gitconfig" user.email "$email"
    git config --file "$HOME/.gitconfig" commit.gpgsign false
    info "wrote $HOME/.gitconfig: the repo's, as $email, unsigned"
  fi
fi

# carapace
CARAPACE_VERSION=1.7.3

if have carapace; then
  info "carapace already installed ($(carapace --version 2>/dev/null || echo unknown))"
else
  step "carapace $CARAPACE_VERSION"
  carapace_tmp="$(mktemp -d)"
  trap 'rm -rf "$carapace_tmp"' EXIT

  carapace_base="https://github.com/carapace-sh/carapace-bin/releases/download/v$CARAPACE_VERSION"
  carapace_tar="carapace-bin_${CARAPACE_VERSION}_linux_amd64.tar.gz"

  if curl -fsSL -o "$carapace_tmp/$carapace_tar" "$carapace_base/$carapace_tar" &&
    curl -fsSL -o "$carapace_tmp/checksums.txt" \
      "$carapace_base/carapace-bin_${CARAPACE_VERSION}_checksums.txt" &&
    (cd "$carapace_tmp" && sha256sum --check --ignore-missing --status checksums.txt); then
    mkdir -p "$HOME/.local/bin"
    tar -xzf "$carapace_tmp/$carapace_tar" -C "$carapace_tmp" carapace
    install -m 0755 "$carapace_tmp/carapace" "$HOME/.local/bin/carapace"
    info "installed $HOME/.local/bin/carapace"
  else
    warn "carapace download or checksum failed — config.fish skips it if absent"
  fi

  rm -rf "$carapace_tmp"
  trap - EXIT
fi

if have tte; then
  info "tte already installed"
else
  step "terminaltexteffects (tte)"
  uv tool install terminaltexteffects
fi

if rustup toolchain list 2>/dev/null | grep -q 'no installed toolchains'; then
  step "rust toolchain"
  rustup default stable
else
  info "rust toolchain already installed"
fi

step "status"
for t in fish starship zoxide fzf carapace eza bat fd rg fastfetch \
  lazygit lazydocker zellij yazi spf nvim gh; do
  if have "$t"; then
    printf '  \033[32m✓\033[0m %s\n' "$t"
  else printf '  \033[31m✗\033[0m %s\n' "$t"; fi
done

cat <<NOTE

  - import GPG and SSH keys
  - gh auth login
  - docker comes from Docker Desktop's WSL integration, which follows the
    default distro
NOTE
