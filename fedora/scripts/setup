#!/usr/bin/env bash

# Manual prerequesites: niri, noctalia, ghostty

set -euo pipefail

REPO_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)"
FEDORA="$REPO_ROOT/fedora"
CONFIG="$HOME/.config"
BACKUP="$HOME/.config-backup"

step() { printf '\n\033[1;34m==>\033[0m %s\n' "$*"; }
info() { printf '  %s\n' "$*"; }
warn() { printf '\033[1;33m  ! \033[0m%s\n' "$*"; }
die() {
  printf '\033[1;31mfatal:\033[0m %s\n' "$*" >&2
  exit 1
}
have() { command -v "$1" >/dev/null 2>&1; }

# Symlink $1 -> $2, never clobbering whatever is already at $2.
link() {
  local src="$1" dst="$2"
  if [[ -L "$dst" ]]; then
    info "$dst already a symlink -> $(readlink "$dst")"
  elif [[ -e "$dst" ]]; then
    warn "$dst already exists — not touching it"
  else
    ln -s "$src" "$dst"
    info "$dst -> $src"
  fi
}

# ── copr repos ────────────────────────────────────────────────────────────────
# The handful of packages Fedora itself doesn't carry.

step "enabling copr repos"
sudo dnf install -y dnf-plugins-core
for c in \
  boobaa/lazygit \
  atim/lazydocker \
  varlad/zellij \
  varlad/yazi \
  atim/starship \
  scottames/ghostty \
  che/nerd-fonts; do
  sudo dnf copr enable -y "$c" || warn "could not enable $c, skipping"
done

# ── packages ──────────────────────────────────────────────────────────────────

PACKAGES=(
  fish starship zoxide fzf
  bat
  eza
  fd-find
  ripgrep
  du-dust
  btop procs duf ncdu tree
  jq yq
  tealdeer
  fastfetch atuin direnv just entr hyperfine glow
  wl-clipboard xclip
  7zip
  unzip unar

  # dev
  neovim git gh
  git-delta
  difftastic
  gnupg2 pinentry
  lazygit lazydocker zellij yazi
  docker-cli docker-compose tokei
  uv python3-pip nodejs24 nodejs24-npm
  @c-development
  cmake
  openssl-devel

  # yazi's preview backends
  ffmpeg-free
  ffmpegthumbnailer
  ImageMagick
  poppler-utils chafa

  fuzzel swaylock playerctl pamixer brightnessctl xwayland-satellite
  nerd-fonts

  gdu golang figlet
)

step "installing packages"
sudo dnf install -y "${PACKAGES[@]}"

# ── things with no dnf package ────────────────────────────────────────────────

if have carapace; then
  info "carapace already installed"
else
  step "carapace"
  sudo tee /etc/yum.repos.d/carapace.repo >/dev/null <<'REPO'
[carapace]
name=carapace
baseurl=https://yum.fury.io/rsteube/
enabled=1
gpgcheck=0
REPO
  sudo dnf install -y carapace-bin || warn "carapace failed — config.fish skips it if absent"
fi

if have spf; then
  info "spf already installed"
else
  step "superfile (spf)"
  curl -sLo- https://superfile.dev/install.sh | bash
fi

if have tte; then
  info "tte already installed"
else
  step "terminaltexteffects (tte)"
  uv tool install terminaltexteffects
fi

if have fnm; then
  info "fnm already installed"
else
  step "fnm"
  curl -fsSL https://fnm.vercel.app/install | bash
fi

if have rustup; then
  info "rustup already installed"
else
  step "rustup"
  curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs | sh -s -- -y
fi

if [[ -f "$HOME/.cargo/env" ]]; then
  source "$HOME/.cargo/env"
fi

# need to use this more, sed alternative
have sd || {
  step "sd"
  cargo install sd
}

# ── login shell ───────────────────────────────────────────────────────────────

step "login shell"
FISH_BIN="$(command -v fish)"

if grep -qxF "$FISH_BIN" /etc/shells; then
  info "$FISH_BIN already in /etc/shells"
else
  info "adding $FISH_BIN to /etc/shells"
  echo "$FISH_BIN" | sudo tee -a /etc/shells >/dev/null
fi

if [[ "$(getent passwd "$USER" | cut -d: -f7)" == "$FISH_BIN" ]]; then
  info "login shell is already fish"
else
  info "switching login shell to fish"
  sudo chsh -s "$FISH_BIN" "$USER"
fi

# ── config ────────────────────────────────────────────────────────────────────

step "adopting $CONFIG"
[[ -d "$FEDORA" ]] || die "no fedora/ directory at $FEDORA"

if [[ -L "$CONFIG" ]]; then
  info "already a symlink -> $(readlink "$CONFIG")"
elif [[ -e "$BACKUP" ]]; then
  warn "$BACKUP already exists — leaving $CONFIG alone"
else
  [[ -d "$CONFIG" ]] || die "$CONFIG is missing or not a directory"

  skipped=()
  while IFS= read -r -d '' src; do
    name="$(basename "$src")"
    if [[ -e "$FEDORA/$name" || -L "$FEDORA/$name" ]]; then
      skipped+=("$name")
    else
      cp -a "$src" "$FEDORA/$name"
    fi
  done < <(find "$CONFIG" -mindepth 1 -maxdepth 1 -print0 | sort -z)

  if ((${#skipped[@]})); then
    info "already in fedora/, skipped:"
    printf '    %s\n' "${skipped[@]}"
  fi

  mv "$CONFIG" "$BACKUP"
  ln -s "$FEDORA" "$CONFIG"
  info "$CONFIG -> $FEDORA, old contents at $BACKUP"
fi

# github ssh workaround

step "ssh config"
mkdir -p "$HOME/.ssh"
chmod 700 "$HOME/.ssh" # ssh ignores the directory outright if it's too open
link "$REPO_ROOT/ssh_config" "$HOME/.ssh/config"

step "gitconfig"
link "$REPO_ROOT/.gitconfig" "$HOME/.gitconfig"

# ── immich api key ────────────────────────────────────────────────────────────
# Prompted for, never taken as an argument — an argument lands in shell history.
# It goes in ~/.local/state and never in the repo: ~/.config is a symlink to
# fedora/, so a key dropped there is one `git add` from being published.

step "immich api key"
IMMICH_STATE="$HOME/.local/state/immich-wallpaper"

if [[ -f "$IMMICH_STATE/api-key" ]]; then
  info "already set at $IMMICH_STATE/api-key"
else
  read -rsp "  immich api key (Account Settings -> API Keys, blank to skip): " key
  echo

  if [[ -n "$key" ]]; then
    mkdir -p "$IMMICH_STATE"
    printf '%s' "$key" >"$IMMICH_STATE/api-key"
    chmod 600 "$IMMICH_STATE/api-key"
    info "wrote $IMMICH_STATE/api-key"
  else
    warn "skipped — immich-wallpaper will not run until this exists"
  fi
  unset key
fi

# ── noctalia settings ─────────────────────────────────────────────────────────
# noctalia keeps its settings in $XDG_STATE_HOME, outside this repo, so the bar
# layout, the enabled plugins and the local plugin source don't come along with a
# clone. fedora/noctalia/settings.toml is a snapshot of them — refresh it with
# scripts/noctalia-save after changing the bar, and commit it.

step "noctalia settings"
NOCTALIA_SETTINGS="$HOME/.local/state/noctalia/settings.toml"
NOCTALIA_SNAPSHOT="$FEDORA/noctalia/settings.toml"

if [[ ! -f "$NOCTALIA_SNAPSHOT" ]]; then
  warn "no snapshot at $NOCTALIA_SNAPSHOT — run scripts/noctalia-save on a configured machine"
elif [[ -f "$NOCTALIA_SETTINGS" ]]; then
  info "settings already exist — not overwriting them"
  info "run scripts/noctalia-save to snapshot this machine's bar into the repo"
else
  mkdir -p "$(dirname "$NOCTALIA_SETTINGS")"
  cp "$NOCTALIA_SNAPSHOT" "$NOCTALIA_SETTINGS"
  # The local plugin source is an absolute path — repoint it at this clone.
  sed -i "s|^\( *\)location = \".*/noctalia-plugins\"|\1location = \"$FEDORA/noctalia-plugins\"|" \
    "$NOCTALIA_SETTINGS"
  info "restored bar layout + plugins from the repo snapshot"
  noctalia config validate >/dev/null 2>&1 ||
    warn "noctalia says the restored config is invalid — check $NOCTALIA_SETTINGS"
fi

# ── timers ────────────────────────────────────────────────────────────────────
# The unit files are in the repo, but systemd's enablement symlink is not.

step "systemd timers"
systemctl --user daemon-reload
systemctl --user enable --now immich-wallpaper.timer
info "next run: $(systemctl --user list-timers immich-wallpaper.timer --no-pager | awk 'NR==2 {print $1, $2, $3}')"

step "status"
for t in fish starship zoxide fzf carapace eza bat fd rg fastfetch \
  lazygit lazydocker zellij yazi spf nvim gh niri noctalia ghostty; do
  if have "$t"; then
    printf '  \033[32m✓\033[0m %s\n' "$t"
  else printf '  \033[31m✗\033[0m %s\n' "$t"; fi
done

cat <<NOTE

  - log out and back in
  - import GPG keys
  - systemctl enable --now docker

To undo the config swap:
  rm "$CONFIG" && mv "$BACKUP" "$CONFIG"
NOTE
